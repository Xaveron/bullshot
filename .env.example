# Wallet private keys, comma-separated (0x prefix optional).
# Use separate wallets with no funds only!
PRIVATE_KEYS=

# X/Twitter usernames, comma-separated, in the same order as the keys (optional)
TWITTER_USERNAMES=

# Your referral code (empty = no referral)
REF_CODE=

# Delay between actions, ms — random within [min,max]
DELAY_MS=[3000,8000]

# Delay between accounts, ms — random within [min,max]
ACCOUNT_DELAY_MS=[2000,6000]

# Mining locations by priority (ids, comma-separated). The first one the account
# qualifies for (level and mining power) is used; if there is not enough energy
# for it, the bot waits instead of spending energy on a cheaper one.
# Empty = auto (location with the highest GEMS reward).
# ids: greenstone-quarry, crystal-cavern, ember-mine, frozen-depths, void-rift
MINING_LOCATIONS=crystal-cavern,greenstone-quarry

# Minimum mining location duration, seconds
MIN_LOCATION_SECONDS=600

# Request timeout and retries on network errors / 429 / 5xx
REQUEST_TIMEOUT_MS=60000
REQUEST_RETRIES=2

# ─── Auto 24/7 mode (seconds) ───
# Extra random wait after the nearest mining position finishes
AUTO_EXTRA_WAIT_SEC=[30,180]
# Wait when there is nothing to mine (no energy / no active positions)
AUTO_IDLE_WAIT_SEC=[1800,3600]
# Bounds for the wait between cycles
AUTO_MIN_WAIT_SEC=60
AUTO_MAX_WAIT_SEC=3600
# Number of cycles (0 = infinite)
AUTO_CYCLES=0
# Mode 8: GEMS that are always kept on the balance (purchases never go below this)
AUTO_GEMS_RESERVE=500
